# Copy this file to .env and fill in real values. Never commit .env.

# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional: email of your sandbox PERSONAL (buyer) account, used as the test invoice recipient
PAYPAL_TEST_RECIPIENT_EMAIL=

# AI provider: Google Gemini (aistudio.google.com > Get API key)
AI_API_KEY=
# A Gemini model ID, e.g. gemini-3.6-flash (stable, free tier)
AI_MODEL=gemini-3.6-flash

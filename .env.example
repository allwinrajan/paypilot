# Copy this file to .env and fill in real values. Never commit .env.

# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional: email of your sandbox PERSONAL (buyer) account, used as the test invoice recipient
PAYPAL_TEST_RECIPIENT_EMAIL=

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
